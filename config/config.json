        "keyword": "Java Backend Engineer",
        "location": "India",
        "country": "IN",
        "time_range": "Past week",
        "remote": "Remote"
      }
    ]
  },
  "browser_board": {
    "_comment": "S&P Global's Workday careers site (JS-rendered; large Hyderabad tech center). The data-automation-id selectors work on any *.myworkdayjobs.com board, so to switch companies change only name + url. Detail pages supply the full description (needed for skill scoring) and all locations (the list shows '2 Locations').",
    "name": "spglobal",
    "url": "https://spgi.wd5.myworkdayjobs.com/SPGI_Careers?q=software%20engineer%20hyderabad",
    "item_selector": "section[data-automation-id=\"jobResults\"] li:has([data-automation-id=\"jobTitle\"])",
    "fields": {
      "title": "[data-automation-id=\"jobTitle\"]",
      "location": "[data-automation-id=\"locations\"] dd",
      "posted": "[data-automation-id=\"postedOn\"] dd"
    },
    "link_selector": "[data-automation-id=\"jobTitle\"]",
    "wait_selector": "[data-automation-id=\"jobTitle\"]",
    "detail_fields": {
      "description": "[data-automation-id=\"jobPostingDescription\"]",
      "location": "[data-automation-id=\"locations\"] dd"
    },
    "detail_limit": 20
  }
