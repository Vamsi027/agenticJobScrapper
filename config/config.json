  "brightdata_linkedin": {
    "_comment": "LinkedIn via Bright Data (needs BRIGHTDATA_API_KEY). Billed per record: at most limit_per_input x queries records per run. time_range uses LinkedIn's labels (Past 24 hours / Past week / Past month / Any time); there is no 5-day option, max_days_old trims the rest.",
    "limit_per_input": 25,
    "timeout_minutes": 10,
    "poll_seconds": 15,
    "queries": [
      {
        "keyword": "Java Developer",
        "location": "Hyderabad",
        "country": "IN",
        "time_range": "Past week"
      },
      {
        "keyword": "Node.js Software Engineer",
        "location": "Hyderabad",
        "country": "IN",
        "time_range": "Past week"
      },
